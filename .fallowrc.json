{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "src/index.{ts,tsx,js,jsx}",
    "src/main.{ts,tsx,js,jsx}"
  ],
  "ignorePatterns": [
    "**/__tests__/**",
    "**/*.test.{ts,tsx}",
    "**/*.spec.{ts,tsx}",
    "vitest.setup.ts"
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "rules": {
    "unused-dependencies": "warn"
  },
  "ignoreDependencies": ["pyodide"],
  "ignoreExports": [
    {
      "file": "src/types/gamification.ts",
      "exports": ["*"]
    },
    {
      "file": "src/types/question.ts",
      "exports": ["*"]
    },
    {
      "file": "src/context/GamificationContext.tsx",
      "exports": ["*"]
    },
    {
      "file": "src/hooks/useGamification.ts",
      "exports": ["*"]
    }
  ]
}
