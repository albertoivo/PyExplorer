# Configuração do Firebase
# Copie este arquivo para .env e preencha com suas credenciais
# Você pode obter estes dados no Console do Firebase > Configurações do Projeto
# https://console.firebase.google.com/

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check - reCAPTCHA v3
VITE_RECAPTCHA_SITE_KEY=

# Administração
# Email do administrador para acesso a ferramentas de debug/seed
VITE_ADMIN_EMAIL=albertoivo@gmail.com
