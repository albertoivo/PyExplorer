rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // FUNÇÕES AUXILIARES
    // ============================================
    
    // Verifica se está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verifica se é o próprio usuário
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Valida que um campo é string com tamanho máximo
    function isValidString(field, maxLength) {
      return field is string && field.size() <= maxLength;
    }
    
    // Valida que um número está dentro de um range
    function isValidNumber(field, min, max) {
      return field is number && field >= min && field <= max;
    }

    // Valida que um campo é timestamp
    function isValidTimestamp(field) {
      return field is timestamp;
    }

    // Valida que um campo é um avatar válido (string, max 500 chars)
    function isValidAvatar(field) {
      return field is string && field.size() <= 500;
    }

    // Valida que um campo é um email válido (string, max 100 chars, contém @)
    function isValidEmail(field) {
      return field is string && field.size() <= 100 && field.matches('.*@.*');
    }

    // Valida se o objeto tem APENAS os campos permitidos
    function hasOnly(data, fields) {
      return data.keys().toSet().hasOnly(fields);
    }

    // Função para verificar se é admin
    function isAdmin() {
      return isAuthenticated() &&
             request.auth.token.email == 'albertoivo@gmail.com' &&
             request.auth.token.email_verified == true;
    }
    
    // ============================================
    // QUESTÕES - Leitura pública, escrita apenas admin
    // ============================================
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // ============================================
    // USUÁRIOS - Cada um só acessa seus dados
    // ============================================
    match /users/{userId} {
      // Simplificado: Se é o dono ou admin, pode ler
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Escrita: Permite se for o dono ou admin com validação de campos numéricos críticos
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) &&
        hasOnly(request.resource.data, ['uid', 'displayName', 'avatar', 'email', 'createdAt', 'updatedAt', 'totalScore', 'balance', 'unlockedWorlds', 'lastLoginAt']) &&
        // Valida displayName (string, max 50 chars)
        (!('displayName' in request.resource.data) || isValidString(request.resource.data.displayName, 50)) &&
        // Valida avatar
        (!('avatar' in request.resource.data) || isValidAvatar(request.resource.data.avatar)) &&
        // Valida email
        (!('email' in request.resource.data) || isValidEmail(request.resource.data.email)) &&
        // Valida createdAt e updatedAt
        (!('createdAt' in request.resource.data) || isValidTimestamp(request.resource.data.createdAt)) &&
        (!('updatedAt' in request.resource.data) || isValidTimestamp(request.resource.data.updatedAt)) &&
        // Valida lastLoginAt se presente
        (!('lastLoginAt' in request.resource.data) || isValidTimestamp(request.resource.data.lastLoginAt)) &&
        // Valida totalScore se presente (0 a 9.999.999)
        (!('totalScore' in request.resource.data) || isValidNumber(request.resource.data.totalScore, 0, 9999999)) &&
        // Valida balance se presente (0 a 9.999.999)
        (!('balance' in request.resource.data) || isValidNumber(request.resource.data.balance, 0, 9999999)) &&
        // Valida unlockedWorlds (deve ser lista)
        (!('unlockedWorlds' in request.resource.data) || request.resource.data.unlockedWorlds is list);
    }

    // ============================================
    // GAMIFICAÇÃO - Cada usuário só acessa seu progresso
    // ============================================
    match /gamification/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      // Escrita com validação de limites para prevenir cheating
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin()) &&
        hasOnly(request.resource.data, ['level', 'streak', 'achievements', 'activeMissions', 'inventory', 'powerUps', 'stats', 'updatedAt']) &&
        // Valida updatedAt
        (!('updatedAt' in request.resource.data) || isValidTimestamp(request.resource.data.updatedAt)) &&
        // Valida level como objeto (Map)
        (!('level' in request.resource.data) || (
           request.resource.data.level is map &&
           hasOnly(request.resource.data.level, ['level', 'currentXP', 'totalXP']) &&
           (!('level' in request.resource.data.level) || isValidNumber(request.resource.data.level.level, 0, 100)) &&
           (!('totalXP' in request.resource.data.level) || isValidNumber(request.resource.data.level.totalXP, 0, 9999999)) &&
           (!('currentXP' in request.resource.data.level) || isValidNumber(request.resource.data.level.currentXP, 0, 9999999))
        )) &&
        // Valida streak como objeto (Map)
        (!('streak' in request.resource.data) || (
           request.resource.data.streak is map &&
           hasOnly(request.resource.data.streak, ['currentStreak', 'longestStreak', 'lastActivityDate', 'activityHistory']) &&
           (!('currentStreak' in request.resource.data.streak) || isValidNumber(request.resource.data.streak.currentStreak, 0, 9999)) &&
           (!('lastActivityDate' in request.resource.data.streak) || isValidString(request.resource.data.streak.lastActivityDate, 10)) &&
           (!('activityHistory' in request.resource.data.streak) || request.resource.data.streak.activityHistory is list)
        )) &&
        // Valida achievements (Lista)
        (!('achievements' in request.resource.data) || request.resource.data.achievements is list) &&
        // Valida activeMissions (Lista)
        (!('activeMissions' in request.resource.data) || request.resource.data.activeMissions is list) &&
        // Valida inventory (Map)
        (!('inventory' in request.resource.data) || (
            request.resource.data.inventory is map &&
            hasOnly(request.resource.data.inventory, ['ownedItems', 'equippedAvatar', 'equippedFrame', 'equippedTitle']) &&
            (!('ownedItems' in request.resource.data.inventory) || request.resource.data.inventory.ownedItems is list) &&
            (!('equippedAvatar' in request.resource.data.inventory) || isValidString(request.resource.data.inventory.equippedAvatar, 100))
        )) &&
        // Valida powerUps (Map)
        (!('powerUps' in request.resource.data) || (
            request.resource.data.powerUps is map &&
            hasOnly(request.resource.data.powerUps, ['inventory', 'usesToday', 'lastResetDate']) &&
            (!('lastResetDate' in request.resource.data.powerUps) || isValidString(request.resource.data.powerUps.lastResetDate, 10)) &&
            (!('inventory' in request.resource.data.powerUps) || request.resource.data.powerUps.inventory is map) &&
            (!('usesToday' in request.resource.data.powerUps) || request.resource.data.powerUps.usesToday is map)
        )) &&
        // Valida stats (Map com campos numéricos)
        (!('stats' in request.resource.data) || (
            request.resource.data.stats is map &&
            hasOnly(request.resource.data.stats, ['totalQuestionsCompleted', 'totalCorrectAnswers', 'consecutiveCorrect', 'bestConsecutiveCorrect', 'weekendQuestionsCount', 'lastWeekendDate', 'totalPlayTime', 'worldsCompleted', 'perfectWorlds', 'bossesDefeated', 'consecutiveFastAnswers', 'completedWorldIds']) &&
            (!('totalQuestionsCompleted' in request.resource.data.stats) || isValidNumber(request.resource.data.stats.totalQuestionsCompleted, 0, 999999)) &&
            (!('totalCorrectAnswers' in request.resource.data.stats) || isValidNumber(request.resource.data.stats.totalCorrectAnswers, 0, 999999)) &&
            (!('lastWeekendDate' in request.resource.data.stats) || isValidString(request.resource.data.stats.lastWeekendDate, 10))
        ));
    }
    
    // ============================================
    // PROGRESSO - Documentos no formato uid_questionId
    // ============================================
    match /userProgress/{progressId} {
      // Função auxiliar para extrair UID do progressId (formato: uid_questionId)
      function extractUidFromProgressId(pId) {
        return pId.split('_')[0];
      }
      
      // Leitura: Permite se:
      // 1. O UID do usuário está no início do progressId (para getDoc individual)
      // 2. Ou o campo uid do documento pertence ao usuário (para queries com where)
      // 3. Ou é admin
      allow read: if isAuthenticated() && (
        extractUidFromProgressId(progressId) == request.auth.uid ||
        (resource != null && resource.data.uid == request.auth.uid) ||
        isAdmin()
      );
      
      // Escrita: Valida que o UID interno do documento pertence ao usuário e os dados são válidos
      allow write: if isAuthenticated() && (
        (extractUidFromProgressId(progressId) == request.auth.uid &&
         request.resource.data.uid == request.auth.uid &&
         hasOnly(request.resource.data, ['uid', 'questionId', 'status', 'score', 'stars', 'attempts', 'bestTimeSeconds', 'lastAttemptAt', 'userAnswer']) &&
         // Valida status se presente
         (!('status' in request.resource.data) || request.resource.data.status in ['not_started', 'in_progress', 'completed']) &&
         // Valida score se presente (0 a 9999)
         (!('score' in request.resource.data) || isValidNumber(request.resource.data.score, 0, 9999)) &&
         // Valida attempts se presente (0 a 9999)
         (!('attempts' in request.resource.data) || isValidNumber(request.resource.data.attempts, 0, 9999)) &&
         // Valida stars se presente (0 a 3)
         (!('stars' in request.resource.data) || isValidNumber(request.resource.data.stars, 0, 3)) &&
         // Valida bestTimeSeconds se presente (0 a 99999)
         (!('bestTimeSeconds' in request.resource.data) || isValidNumber(request.resource.data.bestTimeSeconds, 0, 99999))
        ) ||
        isAdmin()
      );
    }
    // ============================================
    // LEADERBOARD - Dados públicos (sem email/PII)
    // ============================================
    match /leaderboard/{userId} {
      // Leitura pública (para montar o ranking)
      allow read: if isAuthenticated();
      
      // Escrita apenas pelo próprio usuário (para atualizar seu score)
      allow write: if isOwner(userId) &&
        hasOnly(request.resource.data, ['uid', 'displayName', 'avatar', 'totalScore', 'updatedAt']) &&
        (!('displayName' in request.resource.data) || isValidString(request.resource.data.displayName, 50)) &&
        (!('avatar' in request.resource.data) || isValidAvatar(request.resource.data.avatar)) &&
        (!('updatedAt' in request.resource.data) || isValidTimestamp(request.resource.data.updatedAt)) &&
        (!('totalScore' in request.resource.data) || isValidNumber(request.resource.data.totalScore, 0, 9999999));
    }
  }
}
