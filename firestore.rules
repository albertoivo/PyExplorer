rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // FUNÇÕES AUXILIARES
    // ============================================
    
    // Verifica se está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verifica se é o próprio usuário
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Valida que um campo é string com tamanho máximo
    function isValidString(field, maxLength) {
      return field is string && field.size() <= maxLength;
    }
    
    // Valida que um número está dentro de um range
    function isValidNumber(field, min, max) {
      return field is number && field >= min && field <= max;
    }
    // Função para verificar se é admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'albertoivo@gmail.com';
    }
    
    // ============================================
    // QUESTÕES - Leitura pública, escrita apenas admin
    // ============================================
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin(); // Apenas admin pode escrever
    }
    
    // ============================================
    // USUÁRIOS - Cada um só acessa seus dados
    // ============================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      // Validação na escrita para evitar dados malformados
      allow write: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'avatar', 'createdAt', 'updatedAt', 'totalScore', 'lastLoginAt', 'unlockedWorlds'])
        && isValidString(request.resource.data.displayName, 50)
        && isValidNumber(request.resource.data.get('totalScore', 0), 0, 999999);
    }

    // ============================================
    // GAMIFICAÇÃO - Cada usuário só acessa seu progresso
    // ============================================
    match /gamification/{userId} {
      allow read: if isOwner(userId);
      
      // Validação na escrita
      allow write: if isOwner(userId)
        && isValidNumber(request.resource.data.streak.currentStreak, 0, 9999)
        && isValidNumber(request.resource.data.level.totalXP, 0, 9999999);
    }
    
    // ============================================
    // PROGRESSO - Documentos no formato uid_questionId
    // ============================================
    match /userProgress/{progressId} {
      // Leitura: usuário autenticado + documento pertence ao usuário
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      
      // Criação: validação completa dos dados
      allow create: if isAuthenticated() 
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'questionId', 'status', 'score', 'attempts', 'lastAttemptAt'])
        && isValidString(request.resource.data.questionId, 100)
        && request.resource.data.status in ['not_started', 'in_progress', 'completed']
        && isValidNumber(request.resource.data.score, 0, 9999)
        && isValidNumber(request.resource.data.attempts, 0, 9999);
      
      // Atualização: mesmo dono + validações
      allow update: if isAuthenticated() 
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['not_started', 'in_progress', 'completed']
        && isValidNumber(request.resource.data.score, 0, 9999)
        && isValidNumber(request.resource.data.attempts, 0, 9999);
      
      // Deleção: apenas o dono
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
