rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // FUNÇÕES AUXILIARES
    // ============================================
    
    // Verifica se está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verifica se é o próprio usuário
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Valida que um campo é string com tamanho máximo
    function isValidString(field, maxLength) {
      return field is string && field.size() <= maxLength;
    }
    
    // Valida que um número está dentro de um range
    function isValidNumber(field, min, max) {
      return field is number && field >= min && field <= max;
    }
    // Função para verificar se é admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'albertoivo@gmail.com';
    }
    
    // ============================================
    // QUESTÕES - Leitura pública, escrita apenas admin
    // ============================================
    match /questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin(); // Apenas admin pode escrever
    }
    
    // ============================================
    // USUÁRIOS - Cada um só acessa seus dados
    // ============================================
    match /users/{userId} {
      allow read: if isOwner(userId);
      
      // Lista de campos permitidos para escrita
      function allowedKeys() {
        return ['uid', 'email', 'displayName', 'avatar', 'createdAt', 'updatedAt', 'totalScore', 'lastLoginAt', 'unlockedWorlds', 'balance', 'inventory', 'equippedAvatar', 'streak', 'lastActiveDate'].toSet();
      }

      // Validação na criação - todos os campos devem ser válidos
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['uid', 'email', 'displayName'])
        && request.resource.data.keys().toSet().difference(allowedKeys()).size() == 0
        && isValidString(request.resource.data.displayName, 50)
        && isValidNumber(request.resource.data.get('totalScore', 0), 0, 999999)
        && isValidNumber(request.resource.data.get('balance', 0), 0, 999999);
      
      // Validação na atualização
      // Usa diff() para garantir que apenas campos permitidos sejam ALTERADOS ou ADICIONADOS
      // Isso permite que campos legados existam no banco sem bloquear atualizações futuras
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys())
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['displayName']) || isValidString(request.resource.data.displayName, 50))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalScore']) || isValidNumber(request.resource.data.totalScore, 0, 999999))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['balance']) || isValidNumber(request.resource.data.balance, 0, 999999));
    }

    // ============================================
    // GAMIFICAÇÃO - Cada usuário só acessa seu progresso
    // ============================================
    match /gamification/{userId} {
      allow read: if isOwner(userId);
      
      // Validação simplificada: o objeto de gamificação tem estrutura complexa
      // Apenas verifica se é o dono e se os campos principais existem
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAny(['level', 'streak', 'achievements']);
      
      allow update: if isOwner(userId);
    }
    
    // ============================================
    // PROGRESSO - Documentos no formato uid_questionId
    // ============================================
    match /userProgress/{progressId} {
      // Leitura: usuário só pode ler seu próprio progresso
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      
      // Criação: usuário pode criar seu próprio progresso
      allow create: if isAuthenticated() 
        && request.resource.data.uid == request.auth.uid
        && isValidString(request.resource.data.questionId, 100)
        && request.resource.data.status in ['not_started', 'in_progress', 'completed']
        && isValidNumber(request.resource.data.score, 0, 9999)
        && isValidNumber(request.resource.data.attempts, 0, 9999);
      
      // Atualização: dono pode atualizar seu próprio progresso
      allow update: if isAuthenticated() 
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status in ['not_started', 'in_progress', 'completed']
        && isValidNumber(request.resource.data.score, 0, 9999)
        && isValidNumber(request.resource.data.attempts, 0, 9999);
      
      // Deleção: apenas o dono
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }
  }
}
